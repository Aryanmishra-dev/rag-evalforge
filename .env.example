LLM_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text
CHROMA_DB_PATH=./data/chroma_db
OLLAMA_HOST=http://localhost:11434

# Optional: separate judge model for LLM-as-a-judge scoring (defaults to LLM_MODEL).
# JUDGE_MODEL=qwen2.5:7b

# Optional: sentence-transformers cross-encoder for re-ranking (leave empty to use
# the embedding-based re-ranker, e.g. "cross-encoder/ms-marco-MiniLM-L-6-v2").
# RERANKER_MODEL=

# Experiment registry database path.
# EXPERIMENT_DB_PATH=./data/experiments.db

# BM25 / RRF hyper-parameters.
# BM25_K1=1.5
# BM25_B=0.75
# RRF_K=60
